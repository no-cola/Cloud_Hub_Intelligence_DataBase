with open(csv_file, 'r') as f:
    # 将分隔符从'\t'改为','
    reader = csv.reader(f, delimiter=',')
    columns = next(reader)
    
    data = list(reader)
    rows = len(data)
    cols = len(data[0]) if rows > 0 else 0
    print(data)

    # 分析哪些列是字符串类型的
    string_columns = []
    for j in range(cols):
        # 检查此列是否包含非数值数据
        is_string_column = False
        for i in range(rows):
            try:
                int(data[i][j])
            except ValueError:
                try:
                    float(data[i][j])
                except ValueError:
                    # 既不是整数也不是浮点数，则认为是字符串
                    is_string_column = True
                    break
        
        if is_string_column:
            string_columns.append(j)

    # 创建JSON格式的列信息文件，包含表名、列名和行列数
    column_info = {
        "table_name": table_name,
        "columns": columns,
        "rows": rows,
        "cols": cols,
        "string_encoding": "base64_value",  # 记录编码方式改为base64
        "string_columns": string_columns    # 记录哪些列是字符串类型
    }
    
    # 保存到当前目录
    with open("columns.json", 'w') as col_file:
        json.dump(column_info, col_file, indent=2)
    


    from Compiler.library import *
    from Compiler.types import *

    # 字符串转整数函数（使用64进制）
    def str_to_int_base64(s):
        """将字符串转换为整数，使用64进制（0-9, a-z, A-Z, 空格和下划线）"""
        # 定义64进制字符集
        base64_chars = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ _"
        char_to_value = {char: i for i, char in enumerate(base64_chars)}
        
        # 限制长度，避免数值过大
        max_len = 12
        s = s[:max_len]
        
        # 计算: 每个字符的64进制值乘以相应位置的权重
        result = 0
        for char in s:
            # 如果字符不在64进制字符集中，用下划线替代
            value = char_to_value.get(char, char_to_value["_"])
            result = result * 64 + value
        
        return result

    encrypted = Matrix(rows, cols, sint)
    for i in range(rows):
        for j in range(cols):
            # 确保数据能被转换为整数
            try:
                # 先尝试直接转换为整数
                val = int(data[i][j])
            except ValueError:
                # 如果是非数值数据，使用64进制编码
                val = str_to_int_base64(data[i][j])
                print_ln("非数值数据在位置 [%s, %s]: %s，转换为: %s", i, j, data[i][j], val)
            
            encrypted[i][j] = sint(val)

    print_ln("%s", encrypted.reveal())
    encrypted.write_to_file()
    
    print_ln("COLUMNS_FILE:columns.json")

