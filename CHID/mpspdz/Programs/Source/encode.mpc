import csv
import os
import json
import shutil
open('Persistence/Transactions-P0.data', 'w', encoding='utf-8').close()
open('Persistence/Transactions-P1.data', 'w', encoding='utf-8').close()
open('Persistence/Transactions-P2.data', 'w', encoding='utf-8').close()
csv_file = input()
table_name = os.path.splitext(os.path.basename(csv_file))[0]
