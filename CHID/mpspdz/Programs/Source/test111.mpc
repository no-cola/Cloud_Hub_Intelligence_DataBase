import itertools

row = [3, 1,2]
col = [3, 4,2]

# 计算必要参数
total = 0
total_row = 1
total_col = sum(col)
num_blocks = len(col)
start_indices = [0] * num_blocks

# 计算每个块的起始索引和总行数
for i in range(num_blocks):
    start_indices[i] = total
    total += row[i] * col[i]
    total_row *= row[i]

# 生成行索引的笛卡尔积
row_ranges = [range(r) for r in row]
row_combinations = list(itertools.product(*row_ranges))

# 初始化索引矩阵（二维列表）
index_matrix = [[0] * total_col for _ in range(total_row)]

# 填充索引矩阵
for i, combo in enumerate(row_combinations):
    col_start = 0
    for block_idx in range(num_blocks):
        # 计算当前块在一维数组中的起始索引
        start_index = start_indices[block_idx] + combo[block_idx] * col[block_idx]
        # 填充当前块的所有列
        for j in range(col[block_idx]):
            index_matrix[i][col_start + j] = start_index + j
        col_start += col[block_idx]
M = MultiArray([total, 1], sint)
M.read_from_file(0)
print_ln('%s',M.reveal())
N = MultiArray([total_row,total_col],sint)
# 填充结果数组
for m in range(total_row):
    for k in range(total_col):
        N[m][k]=M[index_matrix[m][k]][0]
print_ln('%s',N.reveal())
