# MP-SPDZ 模板导入
from Compiler import mpc_math, MultiArray
import os

# 读取 name_sum.txt 文件内容
def read_name_sum(file_path):
    with open(file_path, 'r') as file:
        lines = file.readlines()
    return lines

# 将 name_sum.txt 内容处理为字典格式
def process_name_sum(name_sum_lines):
    table_dict = {}
    for line in name_sum_lines:
        table_name, rest = line.strip().split(':')
        columns, data_file_path = rest.rsplit(':', 1)
        column_list = columns.split(',')
        table_dict[table_name] = [column_list, data_file_path]
    return table_dict

# 读取 data 文件并进行处理
def read_data(file_path):
    data_array = MultiArray.read_from_file(file_path)
    return data_array

# 主函数
def main():
    # 读取并处理 name_sum.txt 文件
    name_sum_path = "/kk3/name_sum.txt"
    name_sum_lines = read_name_sum(name_sum_path)
    table_dict = process_name_sum(name_sum_lines)
    
    # 手动输入表名和列名
    table_name = input("请输入表名: ")
    column_name = input("请输入列名: ")

    if table_name in table_dict:
        columns, data_file_path = table_dict[table_name]
        if column_name in columns:
            column_index = columns.index(column_name)
            print(f"列名 '{column_name}' 在列表中的下标是 {column_index}")
            print(f"对应的data后缀文件目录是 {data_file_path}")

            # 读取 data 文件
            data_array = read_data(data_file_path)
            print(f"读取到的数据: {data_array}")
        else:
            print(f"列名 '{column_name}' 不存在于表 '{table_name}' 中")
    else:
        print(f"表名 '{table_name}' 不存在")

# 调用主函数
main()
