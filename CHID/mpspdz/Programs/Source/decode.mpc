import json
import os

with open(os.path.join("user","columns_result.json"), 'r') as f:
    data=json.load(f)

rows = data["rows"]
cols = data["cols"]

table_data = MultiArray([rows, cols], sint)
table_data.read_from_file(0)

print_ln("%s",table_data.reveal())

table_data.reveal_to_binary_output(player=0)
